// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Classification {
  PRIMARY
  SUPPRESSED
  EXCLUDED
}

/**
 * PRIMARY      human decision - this is a source a human at Greylist considers worth sending a human being to
 * SUPPRESSED   human decision - this is a source that a human at Greylist considers authentic but non-authoritative (i.e. Reddit) and so does not include them by default
 * EXCLUDED     human decision - this is a source that a human at Greylist considers worth keeping a human being away from.
 * CITED        derived from links
 * UNKNOWN      absence of either condition
 */

model User {
  id        BigInt   @id @default(autoincrement())
  login     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewedSources SourcePolicy[]
}

// --- SOURCES / PAGES ---

model SourcePolicy {
  id BigInt @id @default(autoincrement())

  // What this policy applies to
  domain String

  classification Classification

  scopes    String[]
  expertise String[]

  rationale String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviewedAt DateTime?
  reviewerId BigInt?
  reviewer   User?     @relation(fields: [reviewerId], references: [id])

  @@unique([domain])
}

model Page {
  id BigInt @id @default(autoincrement())

  url          String  @unique
  canonicalUrl String?
  domain       String

  title   String?
  content String?

  httpStatus  Int?
  contentHash String?
  fetchedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outgoingLinks Link[] @relation("SourcePage")
  incomingLinks Link[] @relation("TargetPage")

  crawlAttempts       CrawlAttempt[]
  discoveredCrawlJobs CrawlJob[]

  @@index([domain])
}

model Link {
  id BigInt @id @default(autoincrement())

  fromPageId BigInt
  fromPage   Page   @relation("SourcePage", fields: [fromPageId], references: [id], onDelete: Cascade)

  toPageId BigInt?
  toPage   Page?   @relation("TargetPage", fields: [toPageId], references: [id], onDelete: SetNull)

  toUrl       String
  // Anchor texts reflect the most recent successful observation of this edge.
  // Historical edge existence is preserved, but historical anchor text is not.
  // If anchor history becomes useful, model observations separately rather
  // than accumulating stale anchor text here.
  anchorTexts String[]
  // surroundingText ? 

  firstSeenAt DateTime @default(now())
  // The last successful crawl in which this edge was actually observed, 
  // not the time we last checked for it.
  lastSeenAt  DateTime @default(now())
  // If a link disappears, we set isPresent = false but do not update lastSeenAt.
  isPresent   Boolean  @default(true)

  @@unique([fromPageId, toUrl])
  @@index([fromPageId])
  @@index([toPageId])
  @@index([toUrl])
}

// --- CRAWL ---

enum CrawlJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/**
 * 200 → COMPLETED
 * 301 → COMPLETED
 * 404 → COMPLETED
 * 410 → COMPLETED
 * DNS failure → FAILED
 * timeout → FAILED
 * TLS failure → FAILED
 */

enum CrawlReason {
  PRIMARY
  CITED
  RECRAWL
}

model CrawlJob {
  id BigInt @id @default(autoincrement())

  url String @unique

  reason CrawlReason
  status CrawlJobStatus @default(PENDING)

  discoveredFromPageId BigInt?
  discoveredFromPage   Page?   @relation(fields: [discoveredFromPageId], references: [id], onDelete: SetNull)

  priority Int @default(0)

  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts CrawlAttempt[]

  @@index([status, priority, scheduledAt])
}

model CrawlAttempt {
  id BigInt @id @default(autoincrement())

  jobId BigInt
  job   CrawlJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  url String

  pageId BigInt?
  page   Page?   @relation(fields: [pageId], references: [id], onDelete: SetNull)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  httpStatus Int?
  error      String?

  contentType String?
  bytes       Int?
  durationMs  Int?

  @@index([jobId])
  @@index([url])
  @@index([pageId])
  @@index([startedAt])
}

model CrawlHost {
  hostname String @id

  nextRequestAt DateTime

  robotsTxt       String?
  robotsStatus    Int?
  robotsFetchedAt DateTime?
  robotsExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
